{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "SKYE_ENVIRONMENT": "local"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "SKYE_ENVIRONMENT": "production"
      }
    },
    "beta": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "SKYE_ENVIRONMENT": "production"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "SKYE_ENVIRONMENT": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": {}
    }
  }
}
