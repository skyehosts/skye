{
  "name": "skye-hosts-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist .expo",
    "start": "expo start",
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "echo 'Use EAS Build for native builds'",
    "build:dev:android": "eas build --platform android --profile development",
    "build:dev:ios": "eas build --platform ios --profile development",
    "build:preview:android": "eas build --platform android --profile preview",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:prod:android": "eas build --platform android --profile production",
    "build:prod:ios": "eas build --platform ios --profile production",
    "lint": "eslint \"app/**/*.{ts,tsx}\" --fix",
    "test": "jest --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.6",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@repo/common": "workspace:^",
    "@repo/skye-hosts-api-client": "workspace:*",
    "@repo/web": "workspace:^",
    "@repo/web-components": "workspace:^",
    "@sentry/react-native": "^8.2.0",
    "expo": "~55.0.4",
    "expo-constants": "~55.0.7",
    "expo-crypto": "^55.0.8",
    "expo-dev-client": "~55.0.11",
    "expo-linking": "~55.0.7",
    "expo-local-authentication": "^55.0.8",
    "expo-notifications": "^55.0.11",
    "expo-router": "~55.0.3",
    "expo-secure-store": "~55.0.8",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.71.2",
    "react-native": "0.83.2",
    "react-native-pager-view": "^8.0.0",
    "react-native-paper": "^5.15.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.20.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.2",
    "jest": "^29.2.1",
    "jest-expo": "^55.0.9",
    "typescript": "~5.9.2"
  }
}
