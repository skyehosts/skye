{
  "Description": "Bookings domain messaging infrastructure — prod",
  "Resources": {
    "BookingsDlq536F7731": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "MessageRetentionPeriod": 1209600,
        "QueueName": "bookings-prod-dlq",
        "SqsManagedSseEnabled": true,
        "Tags": [
          {
            "Key": "Domain",
            "Value": "bookings"
          },
          {
            "Key": "Environment",
            "Value": "prod"
          },
          {
            "Key": "ManagedBy",
            "Value": "cdk"
          },
          {
            "Key": "Project",
            "Value": "skyeglamping"
          }
        ]
      },
      "UpdateReplacePolicy": "Retain",
      "DeletionPolicy": "Retain",
      "Metadata": {
        "aws:cdk:path": "BookingsStack-prod/BookingsDlq/Resource"
      }
    },
    "BookingsQueueF3679FCF": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "MessageRetentionPeriod": 345600,
        "QueueName": "bookings-prod",
        "ReceiveMessageWaitTimeSeconds": 20,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": ["BookingsDlq536F7731", "Arn"]
          },
          "maxReceiveCount": 3
        },
        "SqsManagedSseEnabled": true,
        "Tags": [
          {
            "Key": "Domain",
            "Value": "bookings"
          },
          {
            "Key": "Environment",
            "Value": "prod"
          },
          {
            "Key": "ManagedBy",
            "Value": "cdk"
          },
          {
            "Key": "Project",
            "Value": "skyeglamping"
          }
        ],
        "VisibilityTimeout": 300
      },
      "UpdateReplacePolicy": "Retain",
      "DeletionPolicy": "Retain",
      "Metadata": {
        "aws:cdk:path": "BookingsStack-prod/BookingsQueue/Resource"
      }
    },
    "CDKMetadata": {
      "Type": "AWS::CDK::Metadata",
      "Properties": {
        "Analytics": "v2:deflate64:H4sIAAAAAAAA/zPSMzK21DNQTCwv1k1OydbNyUzSqw4uSUzO1kksL44vLizWqw4sTS1N1XFOywMzakEs/9KSgtKSWp28/JRUvaxi/TIjEz1DYz1DxazizEzdotK8kszcVL0gCA0As/RGhWQAAAA="
      },
      "Metadata": {
        "aws:cdk:path": "BookingsStack-prod/CDKMetadata/Default"
      }
    }
  },
  "Outputs": {
    "BookingsQueueUrl": {
      "Description": "URL of the bookings SQS queue (use this to send messages)",
      "Value": {
        "Ref": "BookingsQueueF3679FCF"
      },
      "Export": {
        "Name": "bookings-prod-queue-url"
      }
    },
    "BookingsQueueArn": {
      "Description": "ARN of the bookings SQS queue (use this to grant IAM permissions)",
      "Value": {
        "Fn::GetAtt": ["BookingsQueueF3679FCF", "Arn"]
      },
      "Export": {
        "Name": "bookings-prod-queue-arn"
      }
    },
    "BookingsDlqUrl": {
      "Description": "URL of the bookings dead-letter queue (monitor for processing failures)",
      "Value": {
        "Ref": "BookingsDlq536F7731"
      },
      "Export": {
        "Name": "bookings-prod-dlq-url"
      }
    },
    "BookingsDlqArn": {
      "Description": "ARN of the bookings dead-letter queue",
      "Value": {
        "Fn::GetAtt": ["BookingsDlq536F7731", "Arn"]
      },
      "Export": {
        "Name": "bookings-prod-dlq-arn"
      }
    }
  },
  "Parameters": {
    "BootstrapVersion": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]"
    }
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  ["1", "2", "3", "4", "5"],
                  {
                    "Ref": "BootstrapVersion"
                  }
                ]
              }
            ]
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI."
        }
      ]
    }
  }
}
