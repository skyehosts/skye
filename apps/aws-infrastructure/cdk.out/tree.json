        "id": "AuthStack-prod",
        "path": "AuthStack-prod",
        "constructInfo": { "fqn": "aws-cdk-lib.Stack", "version": "2.239.0" },
        "children": {
          "UserPool": {
            "id": "UserPool",
            "path": "AuthStack-prod/UserPool",
            "constructInfo": {
              "fqn": "aws-cdk-lib.aws_cognito.UserPool",
              "version": "2.239.0"
            },
            "children": {
              "Resource": {
                "id": "Resource",
                "path": "AuthStack-prod/UserPool/Resource",
                "constructInfo": {
                  "fqn": "aws-cdk-lib.aws_cognito.CfnUserPool",
                  "version": "2.239.0"
                },
                "attributes": {
                  "aws:cdk:cloudformation:type": "AWS::Cognito::UserPool",
                  "aws:cdk:cloudformation:props": {
                    "accountRecoverySetting": {
                      "recoveryMechanisms": [
                        { "name": "verified_email", "priority": 1 }
                      ]
                    },
                    "adminCreateUserConfig": {
                      "allowAdminCreateUserOnly": false
                    },
                    "autoVerifiedAttributes": ["email"],
                    "emailVerificationMessage": "Welcome to Skye Glamping! Your verification code is {####}",
                    "emailVerificationSubject": "Verify your Skye Glamping account",
                    "mfaConfiguration": "OFF",
                    "policies": {
                      "passwordPolicy": {
                        "temporaryPasswordValidityDays": 7,
                        "minimumLength": 8,
                        "requireLowercase": true,
                        "requireUppercase": true,
                        "requireNumbers": true,
                        "requireSymbols": false
                      }
                    },
                    "schema": [
                      { "name": "email", "mutable": true, "required": true },
                      {
                        "name": "given_name",
                        "mutable": true,
                        "required": false
                      },
                      {
                        "name": "family_name",
                        "mutable": true,
                        "required": false
                      }
                    ],
                    "smsVerificationMessage": "The verification code to your new account is {####}",
                    "userPoolTags": {
                      "Domain": "auth",
                      "Environment": "prod",
                      "ManagedBy": "cdk",
                      "Project": "skyeglamping"
                    },
                    "usernameAttributes": ["email"],
                    "usernameConfiguration": { "caseSensitive": false },
                    "userPoolName": "auth-prod",
                    "verificationMessageTemplate": {
                      "defaultEmailOption": "CONFIRM_WITH_CODE",
                      "emailMessage": "Welcome to Skye Glamping! Your verification code is {####}",
                      "emailSubject": "Verify your Skye Glamping account",
                      "smsMessage": "The verification code to your new account is {####}"
                    }
                  }
                }
              },
              "HostedUIDomain": {
                "id": "HostedUIDomain",
                "path": "AuthStack-prod/UserPool/HostedUIDomain",
                "constructInfo": {
                  "fqn": "aws-cdk-lib.aws_cognito.UserPoolDomain",
                  "version": "2.239.0"
                },
                "children": {
                  "Resource": {
                    "id": "Resource",
                    "path": "AuthStack-prod/UserPool/HostedUIDomain/Resource",
                    "constructInfo": {
                      "fqn": "aws-cdk-lib.aws_cognito.CfnUserPoolDomain",
                      "version": "2.239.0"
                    },
                    "attributes": {
                      "aws:cdk:cloudformation:type": "AWS::Cognito::UserPoolDomain",
                      "aws:cdk:cloudformation:props": {
                        "domain": "book-skye-prod",
                        "userPoolId": { "Ref": "UserPool6BA7E5F2" }
                      }
                    }
                  }
                }
              }
            }
          },
          "Google": {
            "id": "Google",
            "path": "AuthStack-prod/Google",
            "constructInfo": {
              "fqn": "aws-cdk-lib.aws_cognito.UserPoolIdentityProviderGoogle",
              "version": "2.239.0"
            },
            "children": {
              "Resource": {
                "id": "Resource",
                "path": "AuthStack-prod/Google/Resource",
                "constructInfo": {
                  "fqn": "aws-cdk-lib.aws_cognito.CfnUserPoolIdentityProvider",
                  "version": "2.239.0"
                },
                "attributes": {
                  "aws:cdk:cloudformation:type": "AWS::Cognito::UserPoolIdentityProvider",
                  "aws:cdk:cloudformation:props": {
                    "attributeMapping": {
                      "email": "email",
                      "given_name": "given_name",
                      "family_name": "family_name",
                      "picture": "picture"
                    },
                    "providerDetails": {
                      "client_id": "{{resolve:secretsmanager:/skyeglamping/prod/cognito/google/client-id:SecretString:::}}",
                      "client_secret": "{{resolve:secretsmanager:/skyeglamping/prod/cognito/google/client-secret:SecretString:::}}",
                      "authorize_scopes": "openid email profile"
                    },
                    "providerName": "Google",
                    "providerType": "Google",
                    "userPoolId": { "Ref": "UserPool6BA7E5F2" }
                  }
                }
              }
            }
          },
          "Facebook": {
            "id": "Facebook",
            "path": "AuthStack-prod/Facebook",
            "constructInfo": {
              "fqn": "aws-cdk-lib.aws_cognito.UserPoolIdentityProviderFacebook",
