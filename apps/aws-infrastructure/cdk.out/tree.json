                      "authorize_scopes": "public_profile,email",
                      "api_version": "v19.0"
                    },
                    "providerName": "Facebook",
                    "providerType": "Facebook",
                    "userPoolId": { "Ref": "UserPool6BA7E5F2" }
                  }
                }
              }
            }
          },
          "WebAppClient": {
            "id": "WebAppClient",
            "path": "AuthStack-prod/WebAppClient",
            "constructInfo": {
